{
  "name": "jakit",
  "version": "0.0.0",
  "description": "Agent card and task envelope schemas for agent-to-agent work exchange.",
  "keywords": [
    "jakit",
    "agent-card",
    "task-envelope",
    "agent-fabric",
    "typescript",
    "esm"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./agent-card": {
      "types": "./dist/agent-card.d.ts",
      "import": "./dist/agent-card.js"
    },
    "./envelope": {
      "types": "./dist/envelope.d.ts",
      "import": "./dist/envelope.js"
    },
    "./wire-jakit": {
      "types": "./dist/wire-jakit.d.ts",
      "import": "./dist/wire-jakit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm verify && pnpm build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin"
      ],
      "cpu": [
        "current",
        "arm64"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "homepage": "https://github.com/cachetronaut/jakit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachetronaut/jakit.git"
  },
  "bugs": {
    "url": "https://github.com/cachetronaut/jakit/issues"
  }
}
